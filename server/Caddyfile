{
    servers {
        # site is behind cloudflare: trust its edges and read the real visitor
        # from CF-Connecting-IP. ranges from https://www.cloudflare.com/ips/ (2026-10-15)
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
    }
}

thisisawebsite.fyi {
    root * /var/www/thisisawebsite
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }

    handle /api/* {
        reverse_proxy localhost:8787 {
            # guestbook rate-limits on the last X-Forwarded-For value
            header_up X-Forwarded-For {client_ip}
        }
    }

    handle {
        file_server
    }

    # kernel panic page for missing files. 404s only, so API errors stay JSON.
    handle_errors {
        @notfound expression {err.status_code} == 404
        handle @notfound {
            root * /var/www/thisisawebsite
            rewrite * /404.html
            file_server
        }
    }
}
